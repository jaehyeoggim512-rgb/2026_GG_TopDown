--- !u!114 &1160646314
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1160646313}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b580f3ee9a37e9a4a902a0756728dfef, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Talk
  lines:
  - speaker: ???
    text: ...
  - speaker: "\uB098"
    text: "\uC800, \uC800\uAE30\uC694..."
  - speaker: ???
    text: "\uBB50\uC5D0\uC694, \uB2F9\uC2E0? \uCC98\uC74C\uBCF4\uB294 \uC5BC\uAD74\uC778\uB370."
  - speaker: "\uB098"
    text: "\uC544...\uC804 \uC0C8\uB85C \uB4E4\uC5B4\uC628 \uC0DD\uC874\uC790\uC778\uB370\uC694..."
  - speaker: "\uC138\uB974\uBCA0 \uB974 \uB85C\uC774"
    text: "\uD765, \uADF8\uB7F0\uAC00\uC694. \uB09C \uC138\uB974\uBCA0 \uB974 \uB85C\uC774\uB77C
      \uBD80\uB974\uC138\uC694. \uADF8\uB798\uC11C \uBB34\uC2A8 \uC6A9\uAC74\uC778\uB370\uC694?"
  - speaker: "\uB098"
    text: "...\uD639\uC2DC, \uC800 \uB178\uD2B8 \uC77D\uC5B4\uBCF4\uC168\uB098\uC694? "
  - speaker: "\uC138\uB974\uBCA0 \uB974 \uB85C\uC774"
    text: "\uBB34\uC2A8 \uC18C\uB9AC\uC778\uC9C0 \uBAA8\uB974\uACA0\uB124\uC694,
      \uAD00\uC2EC \uC5C6\uC5B4\uC694."
  - speaker: "\uB098"
    text: '... '
  - speaker: "\uC138\uB974\uBCA0 \uB974 \uB85C\uC774"
    text: "\uB2F9\uC2E0 \uBC29\uC774\uB098 \uB4E4\uC5B4\uAC00\uC9C0 \uADF8\uB798\uC694,
      \uBCF5\uB3C4\uC5D0 \uC788\uC9C0 \uB9D0\uACE0. "
  - speaker: ???
    text: "..\uC544, \uB124. \uC77C\uB2E8 \uAC10\uC0AC\uD569\uB2C8\uB2E4.\n(\uC5EC\uAE30
      \uC0AC\uB78C\uB4E4\uC740 \uB300\uCCB4\uB85C \uBD88\uCE5C\uC808\uD55C\uAC74\uAC00..) "
  - speaker: 
    text: "\uB0B4 \uBC29\uC73C\uB85C \uB4E4\uC5B4\uAC00\uC57C\uD560 \uAC83 \uAC19\uB2E4.
      2\uCE35\uC778\uAC00... "
  - speaker: 
    text: "\uACC4\uB2E8\uC73C\uB85C \uC62C\uB77C\uAC00\uC790. "
  choice1: 
  choice2: 
  onChoice1:
    m_PersistentCalls:
      m_Calls: []
  onChoice2:
    m_PersistentCalls:
      m_Calls: []
  prompt: {fileID: 859667549}
  dialogueBox: {fileID: 1064323863}

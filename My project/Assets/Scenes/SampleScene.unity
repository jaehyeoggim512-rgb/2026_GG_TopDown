  lines:
  - speaker: ???
    text: ...
  - speaker: "\uB098"
    text: "(\uBB34\uC11C\uC6CC \uBCF4\uC774\uB294 \uC0AC\uB78C\uC774 \uC788\uB2E4...
      \uC5BC\uAD74\uC774 \uC798 \uBCF4\uC774\uC9C0 \uC54A\uC544. \uC5B4\uC11C \uAC74\uBB3C\uC744
      \uCC3E\uC544\uC57C\uD558\uB294\uB370.)"
  - speaker: "\uB098"
    text: "\uB458 \uC911 \uC5B4\uB5A4 \uAC74\uBB3C\uC774\uC9C0..?"
  - speaker: ???
    text: "\uC7A0\uAE50, \uAC70\uAE30 \uB2F9\uC2E0."
  - speaker: "\uB098"
    text: "\uB124, \uB124?"
  - speaker: ???
    text: "...\uB204\uAD6C\uC2ED\uB2C8\uAE4C. "
  - speaker: "\uB098"
    text: "\uC544, \uC800\uB294 \uC774\uBC88\uC5D0 \uC0C8\uB85C \uB4E4\uC5B4\uC624\uAC8C
      \uB41C \uC0DD\uC874\uC790\uC778\uB370\uC694..."
  - speaker: ???
    text: "\uADF8\uB7F0\uB370 \uAC70\uAE30\uC11C \uBB50\uD558\uC2ED\uB2C8\uAE4C. "
  - speaker: "\uB098"
    text: "\uAC74\uBB3C\uC744 \uBABB \uCC3E\uACE0 \uC788\uC5B4\uC694.. \uB458 \uC911
      \uC5B4\uB290 \uAC74\uBB3C\uC778\uC9C0 \uC54C\uB824\uC8FC\uC2E4 \uC218 \uC788\uB098\uC694... "
  - speaker: ???
    text: "\uC7A5\uC6D0\uC744 \uB9D0\uC500\uD558\uC2DC\uB294 \uAC70\uB77C\uBA74 \uB4B7\uCABD
      \uAC74\uBB3C\uC785\uB2C8\uB2E4\uB9CC, \uB2F9\uC2E0 \uBC29 \uC5F4\uC1E0\uB97C
      \uAC00\uC9C0\uACE0 \uB4E4\uC5B4\uAC00\uC57C\uD560\uAC81\uB2C8\uB2E4. "
  choice1: "\uADF8\uB7F0\uAC00\uC694, \uC54C\uC558\uC5B4\uC694."
  choice2: "\uC8C4\uC1A1\uD558\uC9C0\uB9CC \uBABB \uBBFF\uACA0\uC5B4\uC694..."

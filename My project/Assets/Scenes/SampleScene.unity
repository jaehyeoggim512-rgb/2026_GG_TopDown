  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b580f3ee9a37e9a4a902a0756728dfef, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  lines:
  - speaker: "\uB098"
    text: "...\uCC45?"
  - speaker: 
    text: "\uB098\uB294 \uCC45\uC744 \uC8FC\uC6E0\uB2E4. \uC790\uC138\uD788 \uC0B4\uD3B4\uBCF4\uB2C8
      \uB204\uAD70\uAC00\uAC00 \uC791\uC131\uD55C\uB4EF\uD55C \uB178\uD2B8\uC600\uB2E4."
  - speaker: "\uB178\uD2B8\uC758 \uB0B4\uC6A9"
    text: "\uADF8\uB7F4 \uB9AC\uAC00 \uC5C6\uC5B4! \uADF8\uB4E4\uC740 \uC774\uACF3\uC744
      \uCC3E\uC744 \uC218 \uC5C6\uC5B4!"
  - speaker: "\uB178\uD2B8\uC758 \uB0B4\uC6A9"
    text: "\uADF8 \uC778\uAC04\uC774 \uC544\uB2CC \uAC83\uC774 \uC5B4\uB514\uC5D0
      \uC228\uC5B4\uC788\uB4E0 \uC774\uBC88 \uAC8C\uC784\uC758 \uCC38\uAC00\uC790\uB4E4\uACFC
      \uBA40\uB9AC \uB5A8\uC5B4\uC838\uC57C \uD574."
  - speaker: "\uB178\uD2B8\uC758 \uB0B4\uC6A9"
    text: "\uC624\uB298 \uBC24\uC774 \uB418\uAE30 \uC804\uC5D0 \uC11C\uB458\uB7EC
      \uB5A0\uB098\uC57C \uD574. \uC232\uC5D0\uC11C \uC5BC\uC5B4 \uC8FD\uB294 \uD55C\uC774
      \uC788\uC5B4\uB3C4 \uADF8\uAC83\uC5D0\uAC8C \uC7A1\uD600\uC120 \uC548 \uB3FC!"
  - speaker: "\uB098"
    text: "\uC774, \uC774\uAC74 \uB300\uCCB4 \uBB34\uC2A8 \uB0B4\uC6A9\uC774\uC9C0..?"
  - speaker: "\uB098"
    text: "\uC774\uACF3\uC5D0 \uC798\uBABB \uB4E4\uC5B4\uC628 \uAC78\uAE4C...?"
  - speaker: "\uB098"
    text: "...\uC800\uBD84\uAED8 \uC774\uACF3\uC5D0 \uB300\uD55C \uC815\uBCF4\uB97C
      \uC5EC\uCB64\uBD10\uC57C\uACA0\uC5B4.."
  choice1: 
  choice2: 
  onChoice1:
    m_PersistentCalls:
      m_Calls: []
  onChoice2:
    m_PersistentCalls:
      m_Calls: []
  prompt: {fileID: 1710815145}
